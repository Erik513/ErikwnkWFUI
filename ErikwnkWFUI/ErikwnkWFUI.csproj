<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <RootNamespace>ErikwnkWFUI</RootNamespace>
    <AssemblyName>ErikwnkWFUI</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Ships ErikwnkWFUI.xml next to the DLL so a consuming project sees
         IntelliSense tooltips from this library's XML doc comments -
         without this, /// <summary> comments only ever help someone
         reading this source, never someone who just added a DLL
         reference. CS1591 ("missing XML comment for publicly visible
         type or member") is suppressed since doc-comment coverage is
         being filled in incrementally, not all at once - only warn on
         comments that exist and are malformed, not on ones that are
         simply missing yet. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Silences CA1416 "only supported on windows" warnings on the
       net8.0-windows leg - every WinForms API call here is already
       Windows-only by definition on this TFM (Microsoft.NET.Sdk +
       UseWindowsForms doesn't auto-emit the assembly-level
       [SupportedOSPlatform] attribute the way Microsoft.NET.Sdk.WindowsDesktop
       would), so the warning has no information value. Meaningless/ignored
       on net48. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!-- Unlike net8.0-windows, the classic .NET Framework SDK-style target
       doesn't implicitly reference these (UseWindowsForms only covers
       System.Windows.Forms) - same set the old-style csproj listed
       explicitly. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <!-- net48 keeps referencing the manually-copied ErikwnkCore build
       output, exactly as before - untouched so SmartRoutine (still on
       .NET Framework 4.8.1) sees zero change on this leg. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="ErikwnkCore">
      <HintPath>..\lib\ErikwnkCore\ErikwnkCore.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Bcl.AsyncInterfaces">
      <HintPath>..\lib\ErikwnkCore\Microsoft.Bcl.AsyncInterfaces.dll</HintPath>
    </Reference>
    <Reference Include="System.Buffers">
      <HintPath>..\lib\ErikwnkCore\System.Buffers.dll</HintPath>
    </Reference>
    <Reference Include="System.Memory">
      <HintPath>..\lib\ErikwnkCore\System.Memory.dll</HintPath>
    </Reference>
    <Reference Include="System.Numerics.Vectors">
      <HintPath>..\lib\ErikwnkCore\System.Numerics.Vectors.dll</HintPath>
    </Reference>
    <Reference Include="System.Runtime.CompilerServices.Unsafe">
      <HintPath>..\lib\ErikwnkCore\System.Runtime.CompilerServices.Unsafe.dll</HintPath>
    </Reference>
    <Reference Include="System.Text.Encodings.Web">
      <HintPath>..\lib\ErikwnkCore\System.Text.Encodings.Web.dll</HintPath>
    </Reference>
    <Reference Include="System.Text.Json">
      <HintPath>..\lib\ErikwnkCore\System.Text.Json.dll</HintPath>
    </Reference>
    <Reference Include="System.Threading.Tasks.Extensions">
      <HintPath>..\lib\ErikwnkCore\System.Threading.Tasks.Extensions.dll</HintPath>
    </Reference>
    <Reference Include="System.ValueTuple">
      <HintPath>..\lib\ErikwnkCore\System.ValueTuple.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- net8.0-windows references the sibling ErikwnkCore project
       directly instead of a manually-copied DLL folder - it already
       dual-targets net48;net8.0 itself. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <ProjectReference Include="..\..\ErikwnkCore\ErikwnkCore\ErikwnkCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icons\IconWeb.png" />
    <EmbeddedResource Include="Icons\IconFolder.png" />
    <EmbeddedResource Include="Icons\IconDocument.png" />
    <EmbeddedResource Include="Icons\IconApplication.png" />
  </ItemGroup>

</Project>
